  "triggers": [
    {
      "name": "trg_dining_events_ai_host_registration",
      "table": "dining_events",
      "timing": "AFTER",
      "event": "INSERT",
      "for_each": "ROW",
      "writes_table": "registrations",
      "insert_columns": [
        "event_id",
        "user_id",
        "registration_status",
        "last_joined_at",
        "last_exited_at"
