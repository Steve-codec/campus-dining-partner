          "columns": [
            "username"
          ]
        }
      ],
      "foreign_keys": [],
      "checks": [
        {
          "name": "ck_users_username",
          "expression": "CHAR_LENGTH(TRIM(username)) > 0 AND username = TRIM(username)",
          "meaning": "用户名非空，且不保留首尾普通空格",
          "enforced": true
        },
        {
          "name": "ck_users_nickname",
          "expression": "CHAR_LENGTH(TRIM(nickname)) > 0",
          "meaning": "昵称不能是空串或仅由普通空格组成",
          "enforced": true
        },
        {
          "name": "ck_users_preferred_slot",
          "expression": "preferred_slot IS NULL OR preferred_slot IN ('BREAKFAST', 'LUNCH', 'DINNER', 'LATE_NIGHT')",
          "meaning": "偏好时段只取四个值或 NULL",
          "enforced": true
        }
      ],
